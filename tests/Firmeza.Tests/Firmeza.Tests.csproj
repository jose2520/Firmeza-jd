<Project Sdk="Microsoft.NET.Sdk">

  <!--
  PROYECTO: Firmeza.Tests (Pruebas Automáticas de Calidad)
  Contiene 95 pruebas que revisan automáticamente que las ventas, el inventario, los precios,
  los archivos de Excel y las validaciones funcionen sin errores antes de publicar cambios.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Herramientas para ejecutar las pruebas y simular una base de datos en memoria -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Conexión con todos los proyectos del sistema para poder probarlos -->
    <ProjectReference Include="..\..\src\Firmeza.Application\Firmeza.Application.csproj" />
    <ProjectReference Include="..\..\src\Firmeza.Domain\Firmeza.Domain.csproj" />
    <ProjectReference Include="..\..\src\Firmeza.Infrastructure\Firmeza.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Firmeza.API\Firmeza.API.csproj" />
  </ItemGroup>

</Project>