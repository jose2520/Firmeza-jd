<Project Sdk="Microsoft.NET.Sdk">

    <!--
    PROYECTO: Firmeza.Infrastructure (Base de Datos y Herramientas Externas)
    Se encarga del trabajo práctico: guardar y consultar datos en PostgreSQL, crear y leer
    archivos de Excel, generar facturas en formato PDF, enviar correos electrónicos y
    crear llaves de acceso seguras (Tokens).
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Conexión con las capas de Dominio y Aplicación -->
        <ProjectReference Include="..\Firmeza.Domain\Firmeza.Domain.csproj" />
        <ProjectReference Include="..\Firmeza.Application\Firmeza.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Librería para crear y leer hojas de cálculo de Excel (.xlsx) -->
        <PackageReference Include="EPPlus" Version="8.7.1" />

        <!-- Librería para diseñar y generar facturas en PDF -->
        <PackageReference Include="itext7" Version="9.7.0" />

        <!-- Manejo de usuarios, contraseñas y roles en la base de datos -->
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Lectura de configuraciones y registro de servicios del sistema -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />

        <!-- Conector oficial para comunicarse con la base de datos PostgreSQL -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

        <!-- Herramienta para generar las llaves digitales de inicio de sesión (JWT) -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />

        <!-- Paquetes de seguridad actualizados para evitar vulnerabilidades -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <!-- Recursos visuales corporativos (Logotipos y branding) -->
        <Content Include="Resources\Assets\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
