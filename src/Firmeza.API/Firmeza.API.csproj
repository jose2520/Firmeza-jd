<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
    PROYECTO: Firmeza.API (Punto de Entrada Web y Atención de Peticiones)
    Es la puerta principal del sistema en internet. Recibe las solicitudes desde páginas web,
    aplicaciones móviles o herramientas de prueba (Swagger/Scalar), revisa los permisos del
    usuario y devuelve las respuestas o archivos solicitados.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Conexión con las capas de Aplicación e Infraestructura -->
        <ProjectReference Include="..\Firmeza.Application\Firmeza.Application.csproj" />
        <ProjectReference Include="..\Firmeza.Infrastructure\Firmeza.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Verificación de llaves de acceso (Tokens JWT) en las rutas protegidas -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

        <!-- Generación de información de rutas para la documentación web -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

        <!-- Herramientas para actualizar la base de datos desde la consola -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Pantallas visuales e interactivas para probar la API (/scalar/v1 y /swagger) -->
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

</Project>
