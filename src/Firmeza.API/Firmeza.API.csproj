<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
    =============================================================================
    PROYECTO: Firmeza.API
    CAPA: Presentación / API Web (ASP.NET Core)
    
    PROPOSITO:
      Expone los endpoints REST para consumo por parte de clientes web (React/Angular/Vue/Mobile)
      o herramientas como Swagger UI. Orquesta las peticiones HTTP hacia los servicios de aplicación.
      
    ORIGEN DE LOS DATOS:
      - Recibe peticiones HTTP (JSON en el Body, Query Parameters, Form-Data para archivos).
      - Lee la configuración de arranque desde 'appsettings.json' y 'launchSettings.json'.
      - Envía respuestas serializadas en formato JSON, octet-stream (Excel) o application/pdf.
      
    AUDITORÍA DE DEPENDENCIAS Y PAQUETES:
      - Microsoft.AspNetCore.Authentication.JwtBearer: Validación de tokens Bearer en cada solicitud protegida.
      - Microsoft.AspNetCore.OpenApi: Soporte de contratos OpenAPI estándar.
      - Microsoft.EntityFrameworkCore.Design: Permite ejecutar comandos de 'dotnet ef' contra el proyecto de inicio.
      - Swashbuckle.AspNetCore: Generador de Swagger y documentación interactiva en /swagger.
    =============================================================================
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Referencias a capas de Aplicación e Infraestructura -->
        <ProjectReference Include="..\Firmeza.Application\Firmeza.Application.csproj" />
        <ProjectReference Include="..\Firmeza.Infrastructure\Firmeza.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Middleware para autenticación mediante Bearer Tokens JWT -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

        <!-- Metadatos de OpenAPI para la API REST -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

        <!-- Herramientas de diseño en tiempo de desarrollo para migraciones de EF Core -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Documentación interactiva moderna con Scalar (/scalar/v1) -->
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />

        <!-- Documentación e interfaz gráfica Swagger UI (/swagger) -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

</Project>
