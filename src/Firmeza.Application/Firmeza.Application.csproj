<Project Sdk="Microsoft.NET.Sdk">

    <!--
    PROYECTO: Firmeza.Application (Coordinación y Formularios de Datos)
    Define las tareas que el sistema puede realizar (vender, registrar clientes, exportar Excel,
    crear PDFs) y las fichas de datos que entran y salen del sistema.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Conexión con la capa de reglas del negocio (Dominio) -->
        <ProjectReference Include="..\Firmeza.Domain\Firmeza.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Herramientas para convertir datos fácilmente y registrar servicios -->
        <PackageReference Include="AutoMapper" Version="16.2.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
