<Project Sdk="Microsoft.NET.Sdk">

    <!--
    PROYECTO: Firmeza.Domain (Reglas del Negocio)
    Aquí viven las reglas principales de la ferretería y los datos base (productos, clientes,
    ventas, vehículos, alquileres y despachos). No depende de ninguna librería externa ni de
    bases de datos para que las reglas se mantengan limpias y seguras.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

</Project>
